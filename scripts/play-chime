#!/usr/bin/env bash
# Play the Today Ping chime on the current PipeWire/Pulse sink.
# Prefer pw-play so we never register as an MPRIS media player.
set -u

file=${1-}
if [[ -z $file || ! -f $file ]]; then
  echo "play-chime: missing file: ${file:-<none>}" >&2
  exit 1
fi

if command -v pw-play >/dev/null 2>&1; then
  exec pw-play --volume=0.65 "$file"
fi

if command -v paplay >/dev/null 2>&1; then
  exec paplay --volume=42000 "$file"
fi

if command -v mpv >/dev/null 2>&1; then
  exec mpv --no-config --no-video --vo=null --really-quiet --volume=90 \
    --no-terminal --force-window=no --audio-display=no "$file"
fi

echo "play-chime: no player found (pw-play, paplay, or mpv)" >&2
exit 1
